<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Goods Inward Prototype</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; margin: 20px; background-color: #f9f9f9; }
        h1 { color: #333; }
        .container { background-color: #fff; border: 1px solid #ddd; border-radius: 8px; padding: 20px; }
        .filters { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; margin-bottom: 20px; }
        .filters div { display: flex; flex-direction: column; }
        .filters label { font-weight: bold; margin-bottom: 5px; font-size: 0.9em; color: #555; }
        .filters input { padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 1em; }
        .actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        #btn-proceed { padding: 10px 20px; font-size: 1em; font-weight: bold; color: #fff; background-color: #007bff; border: none; border-radius: 4px; cursor: pointer; }
        #btn-proceed:disabled { background-color: #a0cfff; cursor: not-allowed; }
        #btn-export { padding: 8px 15px; font-size: 0.9em; color: #333; background-color: #f0f0f0; border: 1px solid #ccc; border-radius: 4px; cursor: pointer; }
        .results { width: 100%; overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; white-space: nowrap; }
        th { background-color: #f4f4f4; }
        #no-data-msg { color: #888; font-style: italic; text-align: center; padding: 20px; }
        .pagination { display: flex; justify-content: center; align-items: center; margin-top: 20px; }
        .pagination button { padding: 8px 12px; margin: 0 5px; cursor: pointer; }
        .pagination span { margin: 0 10px; font-weight: bold; }
    </style>
</head>
<body>

    <h1>Goods Inward Module</h1>

    <div class="container">
        <fieldset>
            <legend>Filters</legend>
            <div class="filters" id="filter-form">
                <div>
                    <label for="f-plant">Plant</label>
                    <input type="text" id="f-plant" class="filter-input">
                </div>
                <div>
                    <label for="f-bill-no">Bill no</label>
                    <input type="text" id="f-bill-no" class="filter-input">
                </div>
                <div>
                    <label for="f-po-no">PO no</label>
                    <input type="text" id="f-po-no" class="filter-input">
                </div>
                <div>
                    <label for="f-material-no">Material number</label>
                    <input type="text" id="f-material-no" class="filter-input">
                </div>
                <div>
                    <label for="f-from-date">From Date (GR Date)</label>
                    <input type="date" id="f-from-date" class="filter-input">
                </div>
                <div>
                    <label for="f-to-date">To Date (GR Date)</label>
                    <input type="date" id="f-to-date" class="filter-input">
                </div>
            </div>
        </fieldset>

        <br>

        <div class="actions">
            <button id="btn-proceed" disabled>Proceed</button>
            <button id="btn-export">Export to Excel</button>
        </div>

        <div class="results">
            <p id="no-data-msg" style="display: none;">No data found for the selected filters.</p>
            <table id="results-table">
                <thead>
                    <tr>
                        <th>Serial Number</th>
                        <th>Bill number</th>
                        <th>Bill date</th>
                        <th>Plant</th>
                        <th>PO number</th>
                        <th>Material number</th>
                        <th>Material description</th>
                        <th>GE number</th>
                        <th>GE date</th>
                        <th>GR No</th>
                        <th>GR Date</th>
                        <th>GR qty</th>
                        <th>Accepted QTY</th>
                        <th>Return qty</th>
                        <th>Currency</th>
                        <th>Amount payable</th>
                        <th>Due date</th>
                        <th>Payment doc</th>
                        <th>Paid date</th>
                    </tr>
                </thead>
                <tbody id="table-body">
                    </tbody>
            </table>
        </div>

        <div class="pagination" id="pagination-controls" style="display: none;">
            <button id="btn-prev">Previous</button>
            <span id="page-info">Page 1 of 1</span>
            <button id="btn-next">Next</button>
        </div>
    </div>

    <script>
        // --- MOCK DATA (Simulates SAP Database) ---
        // Generates 120 mock records
        const MOCK_DATA = Array.from({ length: 120 }, (_, i) => ({
            bill_no: `INV-00${100 + i}`,
            bill_date: `2025-10-${(i % 30) + 1}`,
            plant: `10${(i % 3) + 1}0`,
            po_no: `45000${1234 + i}`,
            mat_no: `MAT-${300 + i}`,
            mat_desc: `Sample Material ${i + 1}`,
            ge_no: `GE${9000 + i}`,
            ge_date: `2025-10-${(i % 30) + 1}`,
            gr_no: `GR${5000 + i}`,
            gr_date: `2025-11-01`, // Default for sorting
            gr_qty: 100 + i,
            accepted_qty: 100 + i,
            return_qty: 0,
            currency: 'INR',
            amount: 5000 + (i * 10),
            due_date: `2025-12-01`,
            pay_doc: `PAY${7000 + i}`,
            paid_date: `2025-12-05`
        }));
        
        // --- CONFIGURATION ---
        const ROWS_PER_PAGE = 50;
        let currentPage = 1;
        let totalRows = 0;
        let filteredData = [];

        // --- DOM ELEMENTS ---
        const filterInputs = document.querySelectorAll('.filter-input');
        const btnProceed = document.getElementById('btn-proceed');
        const btnExport = document.getElementById('btn-export');
        const tableBody = document.getElementById('table-body');
        const noDataMsg = document.getElementById('no-data-msg');
        const paginationControls = document.getElementById('pagination-controls');
        const pageInfo = document.getElementById('page-info');
        const btnPrev = document.getElementById('btn-prev');
        const btnNext = document.getElementById('btn-next');

        // --- EVENT LISTENERS ---

        // 1. Check filters on any input change
        filterInputs.forEach(input => {
            input.addEventListener('input', checkFilters);
        });

        // 2. Handle "Proceed" button click
        btnProceed.addEventListener('click', () => {
            // In a real app, this is where you'd fetch from an API
            // For this prototype, we'll simulate a search
            
            // SIMULATE FILTERING:
            // We'll just pretend the filters were used.
            // To test "No Data", set this to 'no-data'.
            const testScenario = 'data-found'; // Change to 'no-data' to test

            if (testScenario === 'no-data') {
                filteredData = [];
            } else {
                // We just use the mock data as if it were filtered
                filteredData = [...MOCK_DATA]; 
            }

            totalRows = filteredData.length;
            currentPage = 1;
            renderTable();
        });

        // 3. Handle Pagination
        btnPrev.addEventListener('click', () => {
            if (currentPage > 1) {
                currentPage--;
                renderTable();
            }
        });

        btnNext.addEventListener('click', () => {
            const totalPages = Math.ceil(totalRows / ROWS_PER_PAGE);
            if (currentPage < totalPages) {
                currentPage++;
                renderTable();
            }
        });
        
        // 4. Handle Export
        btnExport.addEventListener('click', () => {
            alert('Exporting ALL ' + totalRows + ' records...\n(This is a prototype, data is not actually exported)');
        });


        // --- FUNCTIONS ---

        /**
         * Checks if any filter has a value and enables/disables the "Proceed" button.
         */
        function checkFilters() {
            let atLeastOneFilter = false;
            filterInputs.forEach(input => {
                if (input.value.trim() !== '') {
                    atLeastOneFilter = true;
                }
            });
            btnProceed.disabled = !atLeastOneFilter;
        }

        /**
         * Renders the data grid for the current page.
         */
        function renderTable() {
            // Clear previous results
            tableBody.innerHTML = '';
            
            if (filteredData.length === 0) {
                // SCENARIO: No Data Found
                noDataMsg.style.display = 'block';
                paginationControls.style.display = 'none';
                return;
            }

            // SCENARIO: Data Found
            noDataMsg.style.display = 'none';
            paginationControls.style.display = 'flex';

            // Calculate page details
            const totalPages = Math.ceil(totalRows / ROWS_PER_PAGE);
            const startIndex = (currentPage - 1) * ROWS_PER_PAGE;
            const endIndex = startIndex + ROWS_PER_PAGE;
            const pageData = filteredData.slice(startIndex, endIndex);

            // Populate table
            pageData.forEach((row, index) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${startIndex + index + 1}</td>
                    <td>${row.bill_no}</td>
                    <td>${row.bill_date}</td>
                    <td>${row.plant}</td>
                    <td>${row.po_no}</td>
                    <td>${row.mat_no}</td>
                    <td>${row.mat_desc}</td>
                    <td>${row.ge_no}</td>
                    <td>${row.ge_date}</td>
                    <td>${row.gr_no}</td>
                    <td>${row.gr_date}</td>
                    <td>${row.gr_qty}</td>
                    <td>${row.accepted_qty}</td>
                    <td>${row.return_qty}</td>
                    <td>${row.currency}</td>
                    <td>${row.amount}</td>
                    <td>${row.due_date}</td>
                    <td>${row.pay_doc}</td>
                    <td>${row.paid_date}</td>
                `;
                tableBody.appendChild(tr);
            });

            // Update pagination controls
            pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
            btnPrev.disabled = (currentPage === 1);
            btnNext.disabled = (currentPage === totalPages);
        }
    </script>

</body>
</html>
